{
  "name": "glacier",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint:write": "oxlint --fix",
    "lint:check": "oxlint",
    "format:write": "oxfmt --write --ignore-path .gitignore --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore",
    "ci": "turbo run ci"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.1",
    "husky": "9.1.7",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0"
}
